{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MpvKit",
  "version": "0.1.5",
  "identifier": "io.github.mpvkit",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MpvKit",
        "width": 1040,
        "height": 760,
        "minWidth": 640,
        "minHeight": 600,
        "transparent": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": false,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "shortDescription": "MPV 安装与配置管理器",
    "windows": {
      "allowDowngrades": false,
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese"
        ],
        "displayLanguageSelector": false,
        "installerHooks": "installer/hooks.nsh",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    },
    "resources": {
      "../resources/app-dependency-notices.txt": "third-party/APP-DEPENDENCY-NOTICES.txt",
      "../resources/app-dependency-inventory.json": "third-party/app-dependency-inventory.json",
      "../resources/app-distribution-materials.json": "third-party/app-distribution-materials.json",
      "../resources/licenses/rust-library-COPYRIGHT.txt": "third-party/RUST-COPYRIGHT-library.html",
      "../resources/licenses/webview2-sdk-LICENSE.txt": "third-party/WEBVIEW2-SDK-LICENSE.txt",
      "../resources/licenses/webview2-sdk-NOTICE.txt": "third-party/WEBVIEW2-SDK-NOTICE.txt",
      "../LICENSE": "LICENSE.txt",
      "../COPYING.md": "PROJECT-LICENSE.md"
    },
    "license": "GPL-3.0-or-later"
  }
}
