{
  "name": "mpvkit",
  "version": "0.1.7",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "24.19.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "pnpm typecheck && vite build",
    "tauri": "tauri",
    "test:e2e": "node --test --test-concurrency=1 scripts/native-v016.test.mjs",
    "test:frontend": "node --test scripts/frontend.test.mjs",
    "test:e2e:smoke": "node --test --test-concurrency=1 --test-name-pattern=\"native sidebar\" scripts/native-v016.test.mjs"
  },
  "dependencies": {
    "@mantine/core": "9.7.3",
    "@mantine/hooks": "9.7.3",
    "@tauri-apps/api": "2.12.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "playwright": "1.62.1",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  },
  "license": "GPL-3.0-or-later"
}
